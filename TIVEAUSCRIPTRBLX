local FILE = "TIVEAU_Panel_Config.json"
local Config = {
    targets = {},
    settings = {
        speed = 50, jump = 100, flySpeed = 60, vehSpeed = 120,
        flingTime = 2.5, spin = 720, orbitSpeed = 3, orbitRadius = 6, vehTurn = 110,
        spamMsg = "TIVEAU PANEL", spamDelay = 2, partCount = 120, partSpeed = 4,
    },
}
local function canFile()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end
local function mergeConfig(data)
    if type(data) ~= "table" then return end
    if type(data.targets) == "table" then Config.targets = data.targets end
    if type(data.settings) == "table" then
        for k, v in pairs(data.settings) do Config.settings[k] = v end
    end
end
do
    local loaded = false
    if canFile() then
        local ok = pcall(function()
            if isfile(FILE) then
                mergeConfig(HttpService:JSONDecode(readfile(FILE)))
                loaded = true
            end
        end)
    end
    if not loaded and G.TIVEAU_CFG then mergeConfig(G.TIVEAU_CFG) end
end
local saveQueued = false
local function saveConfig()
    G.TIVEAU_CFG = Config
    if saveQueued then return end
    saveQueued = true
    task.delay(0.5, function()
        saveQueued = false
        if canFile() then pcall(writefile, FILE, HttpService:JSONEncode(Config)) end
    end)
end

