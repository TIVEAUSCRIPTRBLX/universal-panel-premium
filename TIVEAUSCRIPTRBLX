local partPool, lastPool = {}, 0
local function claimOwnership()
    pcall(function() sethiddenproperty(LP, "SimulationRadius", 1e9) end)
    pcall(function() sethiddenproperty(LP, "MaximumSimulationRadius", 1e9) end)
end
local function refreshPartPool()
    local r = root()
    if not r then return end
    lastPool = os.clock()
    local chars = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then chars[p.Character] = true end
    end
    local list, me = {}, r.Position
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and not d.Anchored and d.Size.Magnitude < 80 then
            local skip = false
            local cur = d.Parent
            while cur and cur ~= workspace do
                if chars[cur] then skip = true break end
                cur = cur.Parent
            end
            if not skip then table.insert(list, { part = d, dist = (d.Position - me).Magnitude }) end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    local out = {}
    for i = 1, math.min(#list, Config.settings.partCount) do out[i] = list[i].part end
    partPool = out
end

local partAngle = 0
addConn(RunService.Heartbeat:Connect(function(dt)
    local mode = S.partMode
    if not mode or #partPool == 0 then return end
    partAngle += dt * Config.settings.partSpeed
    local center
    if mode == "tornado" or mode == "levitate" then
        local r = root()
        center = r and r.Position
    else
        local tr = targetRoot(getTarget())
        center = tr and tr.Position
    end
    if not center then return end
    for i, part in ipairs(partPool) do
        if part.Parent and not part.Anchored then
            local v
            if mode == "levitate" then
                v = Vector3.new(0, math.clamp(center.Y + 25 - part.Position.Y, -10, 40), 0)
            elseif mode == "slam" then
                local d = center - part.Position
                v = d.Magnitude > 1 and d.Unit * 300 or Vector3.zero
            else
                local goal
                if mode == "tornado" or mode == "orbitTarget" then
                    local a = partAngle + i * 2.399
                    local rad = 6 + (i % 7) * 2
                    goal = center + Vector3.new(math.cos(a) * rad, 2 + (i % 10) * 2, math.sin(a) * rad)
                elseif mode == "rain" then
                    local a = i * 2.399
                    goal = center + Vector3.new(math.cos(a) * (i % 5), 28 + (i % 6) * 3, math.sin(a) * (i % 5))
                else -- trou noir
                    goal = center + Vector3.new(0, 2, 0)
                end
